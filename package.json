{
  "name": "lc2-helper",
  "version": "0.1.2",
  "private": true,
  "description": "《失落城堡2》流派速查助手：Windows 常驻托盘 + 热键浮窗，不抢游戏焦点",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "desktop": "npm run start -w @lc2/desktop",
    "server": "npm run start -w @lc2/server",
    "dist": "npm run dist -w @lc2/desktop",
    "validate": "node scripts/validate-data.js",
    "test:server": "npm test -w @lc2/server",
    "test": "npm run validate && npm run test:desktop && npm run test:server",
    "server:dev": "npm run dev -w @lc2/server",
    "desktop:hot": "npm run start -w @lc2/desktop",
    "desktop:test": "npm --prefix apps/desktop run test",
    "version:show": "node scripts/version.js show",
    "version:check": "node scripts/version.js check",
    "version:sync": "node scripts/version.js sync",
    "version:patch": "node scripts/version.js patch",
    "version:minor": "node scripts/version.js minor",
    "version:major": "node scripts/version.js major",
    "release": "node scripts/version.js major --release",
    "hooks:install": "node scripts/install-hooks.js",
    "prepare": "node scripts/install-hooks.js",
    "test:desktop": "npm --prefix apps/desktop run test"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Shuijiao926",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shuijiao926/lost_castle_helper.git"
  },
  "homepage": "https://github.com/Shuijiao926/lost_castle_helper#readme",
  "bugs": {
    "url": "https://github.com/Shuijiao926/lost_castle_helper/issues"
  },
  "keywords": [
    "lost-castle-2",
    "electron",
    "overlay",
    "game-helper",
    "windows"
  ]
}
