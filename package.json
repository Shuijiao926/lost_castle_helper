{
  "name": "lc2-helper",
  "version": "0.1.0",
  "private": true,
  "description": "城堡助手 · 失落城堡2 流派速查（monorepo：桌面客户端 + 数据服务）",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "desktop": "npm run start -w @lc2/desktop",
    "server": "npm run start -w @lc2/server",
    "dist": "npm run dist -w @lc2/desktop",
    "validate": "node scripts/validate-data.js"
  },
  "engines": {
    "node": ">=18"
  }
}