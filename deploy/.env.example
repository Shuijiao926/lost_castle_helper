# 部署配置模板：复制为 .env 后按服务器实际值修改。
# .env 只放非密钥配置；密码一律放在 secrets/ 下的独立文件里。
# docker compose 会自动读取同目录的 .env，不需要再传 --env-file。

# 镜像标签，用于区分本地构建的版本（可写成日期或版本号）
LC2_TAG=local

# 构建镜像时的下载源：留空走官方源。国内服务器填就近镜像能显著缩短构建时间。
# 腾讯云内网：DEBIAN_MIRROR=mirrors.tencentyun.com  NPM_REGISTRY=https://mirrors.tencentyun.com/npm
DEBIAN_MIRROR=
NPM_REGISTRY=

# 对外域名：Caddy 会自动申请并续期证书，前提是 80/443 可从公网访问
LC2_DOMAIN=castle-helper.fun

# Java 管理端读取的导入目录（宿主机路径，compose 会挂到容器 /imports/data）
LC2_IMPORT_DIR=./imports

# 客户端拉取静态数据包的目录（宿主机路径，Caddy 挂到 /srv/data）
LC2_DATA_DIR=./data

# 允许跨域的来源，逗号分隔；留空表示允许全部（桌面客户端不发 Origin，留空即可）
LC2_CORS_ORIGINS=

# 数据库初始化参数：只在空数据目录首次启动时生效，改动不会修改已有库
POSTGRES_DB=lc2
POSTGRES_USER=lc2_admin
