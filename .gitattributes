# 换行符归属：谁在 Linux 上跑，谁就必须是 LF。
#
# Windows 上 core.autocrlf=true 会让 .sh / .py 在 checkout 时变成 CRLF，
# 上传到服务器后 shebang 变成 `#!/usr/bin/env bash\r`，直接报
# `bad interpreter: No such file or directory`，而且肉眼看不出来。
# 这里按后缀钉死，和 autocrlf 无关。

*.sh            text eol=lf
*.py            text eol=lf
.githooks/*     text eol=lf

# 容器与反向代理配置同理：CRLF 会被当成配置内容的一部分
Dockerfile      text eol=lf
.dockerignore   text eol=lf
deploy/caddy/Caddyfile text eol=lf
deploy/compose.yaml    text eol=lf

# Windows 侧脚本保持 CRLF
*.ps1           text eol=crlf
*.cmd           text eol=crlf
*.bat           text eol=crlf
