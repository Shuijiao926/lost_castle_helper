# ===== 服务 =====
PORT=4317
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# ===== 接口 =====
# API_PREFIX=/api
# API_ADMIN_HEADER=x-admin-token

# ===== 数据目录 =====
# 留空使用 <仓库根>/data；运行时数据写到 <dataDir>/runtime
# DATA_DIR=
# RUNTIME_DIR=

# ===== 数据库（P4 才用；留空 = JSON 文件存储）=====
DATABASE_URL=

# ===== 管理员口令（审核接口用）=====
ADMIN_TOKEN=change_me

# ===== 安全管控（限流）=====
# RATING_RATE_LIMIT=20
# RATING_RATE_WINDOW_MS=60000
# SUBMISSION_RATE_LIMIT=5
# SUBMISSION_RATE_WINDOW_MS=600000
# SECURITY_STORE_FILE=security-limits.json

# ===== 跨域（生产建议填白名单，逗号分隔）=====
# CORS_ORIGINS=https://example.com
# CORS_MAX_AGE=86400

# ===== 请求体 / 上传上限 =====
# MAX_BODY_BYTES=1048576
# MAX_UPLOAD_BYTES=8388608

# ===== 数据包对外地址前缀（GitHub raw / OSS）=====
# FILE_BASE_URL=https://raw.githubusercontent.com/Shuijiao926/lost_castle_helper/main/data/runtime/packages
# PACKAGE_FILE_PREFIX=builds
FILE_BASE_URL=
