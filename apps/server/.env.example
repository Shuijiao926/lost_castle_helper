# ===== 服务 =====
PORT=4317
HOST=0.0.0.0
NODE_ENV=development

# ===== 数据库 =====
# 留空则降级为「JSON 文件存储」（骨架阶段可直接跑，无需装数据库）
DATABASE_URL=

# ===== 文件存储 =====
# github : 文件放 GitHub 仓库 / Releases（当前方案，零成本）
# local  : 存服务器磁盘（开发用）
FILE_STORAGE=github

# GitHub 数据仓库（客户端从这里拉数据与图标）
GITHUB_OWNER=Shuijiao926
GITHUB_REPO=lost_castle_helper
GITHUB_BRANCH=main
GITHUB_TOKEN=            # 上传文件时需要；只读拉取可不填

# ===== 运营 =====
ADMIN_TOKEN=change_me    # 审核接口的临时口令，正式版换账号体系
