// 城堡助手数据模型（P4 才启用；P1 走 JSON 文件仓储）
//
// 目录结构说明：这里按「限界上下文」分区，
// 与 src/modules/<上下文> 一一对应，方便将来拆分服务。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 图鉴上下文（catalog）：只读参考数据，采集器写入
// ============================================================

model WeaponType {
  id    String @id // THW / SHW / STAFF / DB / BOW / FD / GUN / PL / KA
  name  String
  short String
  forms Json? // 形态列表，如 ["重剑/大刀", "重斧/重锤"]
  note  String @default("")
  sort  Int    @default(0)

  inscriptions Inscription[]
  builds       Build[]

  @@map("weapon_type")
}

model Inscription {
  id           String @id
  name         String
  weaponTypeId String
  kind         String @default("normal") // normal | hunter
  effect       String @default("")
  icon         String?
  sort         Int    @default(0)

  weaponType WeaponType @relation(fields: [weaponTypeId], references: [id])
  builds     Build[]

  @@index([weaponTypeId])
  @@map("inscription")
}

model Treasure {
  id       String  @id
  name     String
  rarity   String // 普通/优秀/稀有/史诗/传奇
  depth    String? // S/R/1/2 —— 仅内部排序用，永不返回给客户端
  classify String? // 宝物流派分类 id（school）
  icon     String?
  version  String  @default("")

  @@index([rarity])
  @@index([classify])
  @@map("treasure")
}

model School {
  id   String @id
  name String
  kind String @default("classify") // classify | rune

  @@map("school")
}

/// 图鉴导入批次：便于回溯「这批数据来自哪次采集」
model CatalogVersion {
  id          Int      @id @default(autoincrement())
  gameVersion String
  source      String   @default("wiki")
  importedAt  DateTime @default(now())
  stats       Json?

  @@map("catalog_version")
}

// ============================================================
// 流派上下文（builds）：聚合根 Build
// ============================================================

enum BuildStatus {
  DRAFT
  REVIEWING
  PUBLISHED
  ARCHIVED
}

model Build {
  id           String      @id
  name         String
  weaponTypeId String
  inscriptionId String
  author       String
  status       BuildStatus @default(DRAFT)
  rating       Float       @default(0)
  votes        Int         @default(0)
  gameVersion  String
  sourceType   String      @default("maintainer") // wiki|self-test|authorized-submission|pr|maintainer
  sourceUrl    String?
  license      String      @default("CC-BY-NC-SA-4.0")
  payload      Json // 完整流派数据（8 个区块 + 内部字段）
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  weaponType  WeaponType      @relation(fields: [weaponTypeId], references: [id])
  inscription Inscription     @relation(fields: [inscriptionId], references: [id])
  versions    BuildVersion[]
  ratings     Rating[]

  @@index([status])
  @@index([weaponTypeId])
  @@index([inscriptionId])
  @@map("build")
}

model BuildVersion {
  id        Int      @id @default(autoincrement())
  buildId   String
  version   Int
  payload   Json
  note      String?
  createdAt DateTime @default(now())

  build Build @relation(fields: [buildId], references: [id], onDelete: Cascade)

  @@unique([buildId, version])
  @@map("build_version")
}

// ============================================================
// 投稿上下文（submissions）
// ============================================================

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Submission {
  id              String           @id
  buildId         String
  author          String
  contact         String?
  source          String?
  sourceType      String           @default("authorized-submission")
  licenseAccepted Boolean          @default(false)
  status          SubmissionStatus @default(PENDING)
  payload         Json
  files           Json?
  reviewNote      String?
  reviewedAt      DateTime?
  createdAt       DateTime         @default(now())

  @@index([status])
  @@map("submission")
}

// ============================================================
// 评分上下文（ratings）
// ============================================================

model Rating {
  id       Int      @id @default(autoincrement())
  buildId  String
  score    Float
  voterKey String
  createdAt DateTime @default(now())

  build Build @relation(fields: [buildId], references: [id], onDelete: Cascade)

  @@unique([buildId, voterKey])
  @@index([buildId])
  @@map("rating")
}

// ============================================================
// 发布上下文（publishing）
// ============================================================

model DataPackage {
  id          Int      @id @default(autoincrement())
  version     String   @unique // 如 1.0.1.3-r2
  gameVersion String
  fileUrl     String
  fileHash    String
  size        Int
  notes       String   @default("")
  publishedAt DateTime @default(now())

  @@index([publishedAt])
  @@map("data_package")
}

// ============================================================
// 资产上下文（assets）
// ============================================================

model Asset {
  id        Int      @id @default(autoincrement())
  kind      String // icon | screenshot | cover
  filename  String
  url       String
  hash      String
  size      Int
  createdAt DateTime @default(now())

  @@unique([kind, filename])
  @@map("asset")
}
