// 城堡助手数据模型
// 说明：骨架阶段 DATABASE_URL 为空时不会连库，服务走 JSON 文件存储；
//       配好 PostgreSQL 后执行 npm run db:push 即可启用。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BuildStatus {
  DRAFT      // 编辑中
  REVIEWING  // 待审核
  PUBLISHED  // 已发布（客户端可见）
  ARCHIVED   // 已下架
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

/// 流派主表：payload 存整条流派数据（与 data/builds.json 一条记录同构），
/// 这样后台字段调整不会牵动数据库结构。
model Build {
  id           String      @id
  name         String
  weaponType   String      // THW/SHW/...
  inscriptionId String
  author       String
  rating       Float       @default(0)
  votes        Int         @default(0)
  status       BuildStatus @default(DRAFT)
  gameVersion  String
  payload      Json
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  versions  BuildVersion[]
  ratings   Rating[]

  @@index([status])
  @@index([weaponType])
}

/// 历史版本，支持回滚
model BuildVersion {
  id        Int      @id @default(autoincrement())
  buildId   String
  version   Int
  payload   Json
  note      String?
  createdAt DateTime @default(now())

  build Build @relation(fields: [buildId], references: [id], onDelete: Cascade)

  @@unique([buildId, version])
}

/// 评分：同一 voterKey 对同一流派只保留最后一次
model Rating {
  id        Int      @id @default(autoincrement())
  buildId   String
  score     Float
  voterKey  String
  createdAt DateTime @default(now())

  build Build @relation(fields: [buildId], references: [id], onDelete: Cascade)

  @@unique([buildId, voterKey])
  @@index([buildId])
}

/// 玩家投稿：截图等附件存文件服务，这里只存引用
model Submission {
  id         Int              @id @default(autoincrement())
  buildId    String
  author     String
  contact    String?
  status     SubmissionStatus @default(PENDING)
  payload    Json
  sourceUrl  String?
  files      Json?            // [{ name, url, size }]
  reviewNote String?
  createdAt  DateTime         @default(now())
  reviewedAt DateTime?

  @@index([status])
}

/// 数据包：客户端热更新用。发布后客户端比对 version 决定是否拉取。
model DataPackage {
  id          Int      @id @default(autoincrement())
  version     String   @unique   // 如 1.0.1.3-r2
  gameVersion String
  fileUrl     String             // GitHub Release / OSS 地址
  fileHash    String             // sha256，客户端校验
  size        Int
  notes       String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

/// 管理员（骨架阶段先用 ADMIN_TOKEN，正式版切账号）
model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String   // bcrypt hash
  createdAt DateTime @default(now())
}
