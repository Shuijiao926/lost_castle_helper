{
  "name": "@lc2/desktop",
  "version": "0.1.25",
  "description": "城堡助手 · 失落城堡2 流派速查（Electron 客户端，常驻托盘 + 热键浮窗）",
  "main": "src/main/index.js",
  "author": "Shuijiao926",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "chcp 65001 >nul && electron .",
    "dev": "chcp 65001 >nul && electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.lc2helper.app",
    "productName": "LC2 Helper",
    "npmRebuild": false,
    "electronDist": "../../node_modules/electron/dist",
    "directories": {
      "output": "../../release"
    },
    "extraResources": [
      {
        "from": "../../data",
        "to": "data",
        "filter": [
          "**/*",
          "!builds.local.json"
        ]
      },
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "native",
        "to": "native"
      }
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "artifactName": "LC2Helper-${version}-win-${arch}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "LC2Helper-${version}-portable.exe",
      "unpackDirName": false
    }
  }
}
